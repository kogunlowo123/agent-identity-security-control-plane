{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentRegistryEntry",
  "description": "Schema for agent registry profile definitions",
  "type": "object",
  "required": ["agent_id", "spiffe_id", "tier", "capabilities", "max_ttl", "max_delegation_depth"],
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}[a-z0-9]$",
      "description": "Unique agent identifier, kebab-case"
    },
    "display_name": {
      "type": "string",
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "spiffe_id": {
      "type": "string",
      "pattern": "^spiffe://[a-z0-9.-]+/[a-zA-Z0-9/_-]+$"
    },
    "tier": {
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "max_ttl": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "allowed_data_classifications": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["public", "internal", "confidential", "restricted"]
      }
    },
    "rate_limits": {
      "type": "object",
      "properties": {
        "requests_per_minute": { "type": "integer", "minimum": 1 },
        "tokens_per_minute": { "type": "integer", "minimum": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "owner_team": { "type": "string" },
        "contact": { "type": "string", "format": "email" },
        "created_at": { "type": "string", "format": "date" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
