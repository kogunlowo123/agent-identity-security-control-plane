# =============================================================================
# Agent Identity Security Control Plane - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for local development.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# -----------------------------------------------------------------------------
# API Service
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://aicp_user:aicp_pass@localhost:5432/aicp_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# OpenSearch
# -----------------------------------------------------------------------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=aicp
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# -----------------------------------------------------------------------------
# Identity / SPIFFE
# -----------------------------------------------------------------------------
TRUST_DOMAIN=agent-identity-security-control-plane
SPIRE_SOCKET_PATH=/tmp/spire-agent/public/api.sock
SIGNING_KEY_PEM_PATH=/etc/aicp/keys/signing.pem
# Or provide inline (base64-encoded RSA private key):
# SIGNING_KEY_PEM=

# JWT settings
JWT_ALGORITHM=RS256
JWT_ISSUER=https://aicp.example.com
JWT_AUDIENCE=aicp-api

# TTL per tier (seconds)
TOKEN_TTL_T0=3600
TOKEN_TTL_T1=1800
TOKEN_TTL_T2=900
TOKEN_TTL_T3=300

# -----------------------------------------------------------------------------
# OPA (Open Policy Agent)
# -----------------------------------------------------------------------------
OPA_URL=http://localhost:8181
OPA_BUNDLE_PATH=/bundles

# -----------------------------------------------------------------------------
# GCP
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# GCS
GCS_BUCKET_ARTIFACTS=your-artifacts-bucket
GCS_BUCKET_MODELS=your-models-bucket
GCS_BUCKET_AUDIT_LOGS=your-audit-logs-bucket

# Pub/Sub
PUBSUB_TOPIC_IDENTITY_ISSUED=projects/your-project/topics/identity-issued
PUBSUB_TOPIC_IDENTITY_REVOKED=projects/your-project/topics/identity-revoked
PUBSUB_TOPIC_IDENTITY_VIOLATED=projects/your-project/topics/identity-violated

# KMS
KMS_KEY_RING=aicp-keyring
KMS_CRYPTO_KEY=aicp-app-key

# Vertex AI
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# LLM Configuration (LiteLLM)
# -----------------------------------------------------------------------------
LITELLM_MODEL=vertex_ai/gemini-1.5-pro
LITELLM_FALLBACK_MODEL=anthropic/claude-3-sonnet-20240229
LITELLM_MAX_TOKENS=4096
LITELLM_TEMPERATURE=0.0

# OpenAI fallback (if enabled)
# OPENAI_API_KEY=sk-...

# Anthropic fallback (if enabled)
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# OpenTelemetry
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aicp-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# -----------------------------------------------------------------------------
# Redis (for caching and rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_DEFAULT=3600

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_T0=1000
RATE_LIMIT_T1=500
RATE_LIMIT_T2=100
RATE_LIMIT_T3=10

# -----------------------------------------------------------------------------
# Dagster (data pipelines)
# -----------------------------------------------------------------------------
DAGSTER_HOME=/var/dagster
DAGSTER_POSTGRES_URL=postgresql://dagster_user:dagster_pass@localhost:5432/dagster_db
